{% set root = "" %}{% for _ in range(2, page.url.split("/").length) %}{% set root = root + "../" %}{% endfor %}<!DOCTYPE html>
<html>

<head>
    <title>{{ title }} | AYVACS</title>
    <link rel="stylesheet" href="{{ root }}styles/colours.css">
    <link rel="stylesheet" href="{{ root }}styles/blogpost.css">
    <base target="_blank">

    <link rel="apple-touch-icon" sizes="180x180" href="{{ root }}res/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ root }}res/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ root }}res/favicon/favicon-16x16.png">
    <link rel="manifest" href="res/favicon/site.webmanifest">
</head>

<body>
    <div id="blog_main">
        <h3 id="header">AYVACS <a href="{{ root }}">home</a></h3>
        <p id="date">{{ date | sentenceDate }}</p>
        <h1>{{ title }}</h1>

        <hr>

        <div id="blog-content">{{ content | safe }}</div>

        <hr>

        <p id="copyright">&copy; {{ date | year }} ayvacs. all rights reserved. <a id="view-source"></a></p>
    </div>

    <!-- Add view edit history btn -->
    <script>
        const inputPath = "{{ page.inputPath }}".replace(/^\.\//, "");
        const btn = document.getElementById("view-source");

        btn.href = `https://github.com/ayvacs/blog/commits/main/${inputPath}`;
        btn.textContent = "view edit history";
    </script>

    <!-- Add hightlight.js syntax highlighting for codeblocks -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/vs2015.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    <script>hljs.highlightAll();</script>
    <style>
        /* hljs override styles */
                .hljs { background: none; }
        pre code.hljs { padding: 0; }
    </style>
</body>

</html>